# Public, non-secret defaults for the local-only Docker Compose services.
# Copy only the values you need into the ignored .env.local file.
POSTGRES_DB=bbw
POSTGRES_USER=bbw
POSTGRES_PASSWORD=bbw-local-only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://bbw:bbw-local-only@127.0.0.1:5432/bbw

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=127.0.0.1
SMTP_PORT=1025

LOCALSTACK_PORT=4566
LOCALSTACK_ENDPOINT_URL=http://127.0.0.1:4566
AWS_REGION=us-east-1
# LocalStack requires credential-shaped values but does not authenticate them.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
