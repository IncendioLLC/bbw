{
  "name": "@bbw/platform",
  "version": "0.0.0",
  "private": true,
  "description": "BBW Stage 1 platform monorepo",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": "12.6.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "license:check": "node scripts/check-licenses.mjs",
    "openapi:generate": "node scripts/openapi/generate-openapi.mjs --write",
    "openapi:check": "node scripts/openapi/check-openapi.mjs",
    "lint": "pnpm lint:repo && turbo run lint",
    "lint:repo": "eslint .",
    "format:check": "prettier --check .",
    "security:scan": "node scripts/security/run-security-checks.mjs",
    "test": "turbo run test && pnpm test:unit",
    "test:e2e": "playwright test",
    "test:integration": "turbo run test:integration",
    "test:unit": "vitest run --coverage",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "10.11.0",
    "happy-dom": "20.14.5",
    "prettier": "3.9.9",
    "turbo": "2.11.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2",
    "zod": "4.6.5"
  }
}
