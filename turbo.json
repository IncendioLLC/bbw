{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".node-version", "pnpm-lock.yaml", "packages/config/tsconfig/*.json"],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": [] },
    "dev": { "cache": false, "persistent": true },
    "lint": { "dependsOn": ["^lint"], "outputs": [] },
    "typecheck": { "dependsOn": ["^typecheck"], "outputs": ["*.tsbuildinfo", "**/*.tsbuildinfo"] },
    "test": { "dependsOn": ["build", "^test"], "outputs": [] },
    "test:integration": {
      "dependsOn": ["build", "^test:integration"],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": ["work/playwright-results/**", "work/playwright-report/**"]
    }
  }
}
